{
  "name": "jenesis-accounting",
  "productName": "JENESIS",
  "version": "0.1.0",
  "description": "JENESIS - business management and accounting by KAYIGANWA JACQUES",
  "author": "KAYIGANWA JACQUES",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "build:client": "vite build",
    "build": "vite build",
    "release:zip": "npm run build && node scripts/package-source.cjs",
    "test": "node tests/accounting-engine.test.js",
    "test:desktop": "node tests/desktop-backend.test.js",
    "test:all": "npm test && npm run test:crud && npm run test:currencies && npm run test:modes && npm run test:lan && npm run test:snapshots && npm run test:ui && npm run test:auth && npm run test:security && npm run test:desktop && npm run test:setup && npm run test:recovery && npm run test:errors && npm run test:payments && npm run test:i18n",
    "test:crud": "node tests/crud-workflows.test.cjs",
    "test:currencies": "node tests/currency-posting.test.cjs",
    "test:modes": "node tests/app-modes.test.cjs",
    "test:lan": "node tests/lan-host.test.cjs",
    "test:snapshots": "node tests/startup-snapshots.test.cjs",
    "test:ui": "vitest run tests/ui --maxWorkers=1 --minWorkers=1",
    "test:setup": "node tests/setup-state.test.cjs",
    "test:recovery": "node tests/recovery.test.cjs",
    "test:errors": "node tests/error-codes.test.cjs",
    "test:payments": "node tests/payments-display.test.cjs",
    "test:i18n": "node tests/i18n.test.cjs",
    "desktop": "electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "test:auth": "node tests/auth-security.test.js",
    "test:security": "node tests/security-hardening.test.js",
    "test:e2e": "python3 tests/e2e/auth_ui_test.py"
  },
  "build": {
    "appId": "com.jenesis.accounting",
    "productName": "JENESIS",
    "copyright": "Copyright (c) 2026 KAYIGANWA JACQUES",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/tests/**",
      "assets/j-*.ico"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "assets/j-seller.ico",
        "to": "icons/j-seller.ico"
      },
      {
        "from": "assets/j-administrator.ico",
        "to": "icons/j-administrator.ico"
      },
      {
        "from": "assets/j-network.ico",
        "to": "icons/j-network.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/j-administrator.ico",
      "artifactName": "JENESIS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JENESIS Administrator",
      "uninstallDisplayName": "JENESIS",
      "deleteAppDataOnUninstall": false,
      "include": "installer/shortcuts.nsh",
      "installerIcon": "assets/j-administrator.ico",
      "uninstallerIcon": "assets/j-administrator.ico"
    }
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^2.1.9"
  }
}
