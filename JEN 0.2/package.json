{
  "name": "genesis-accounting",
  "productName": "JENESIS",
  "version": "1.0.0",
  "description": "JENESIS - Professional Business Accounting & Management Software",
  "author": "JENESIS",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "build:client": "vite build",
    "build": "vite build",
    "test": "node tests/accounting-engine.test.js",
    "test:desktop": "node tests/desktop-backend.test.js",
    "test:ops": "node tests/operations.test.js",
    "test:migrations": "node tests/migrations-v2.test.js",
    "test:i18n": "node tests/i18n-parity.test.js",
    "test:fx": "node tests/fx-settlement.test.js",
    "test:all": "npm test && npm run test:auth && npm run test:security && npm run test:desktop && npm run test:ops && npm run test:migrations && npm run test:i18n && npm run test:fx",
    "desktop": "electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "test:auth": "node tests/auth-security.test.js",
    "test:security": "node tests/security-hardening.test.js",
    "test:e2e": "python3 tests/e2e/auth_ui_test.py"
  },
  "build": {
    "appId": "com.jenesis.accounting",
    "productName": "JENESIS",
    "copyright": "Copyright (c) JENESIS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "build/icon.ico",
      "!**/*.map",
      "!**/tests/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "JENESIS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JENESIS",
      "uninstallDisplayName": "JENESIS",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
